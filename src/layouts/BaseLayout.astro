---
/* Schriften selbst gehostet (DSGVO) — kein Google-Fonts-CDN. */
import '@fontsource-variable/inter';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '../styles/global.css';

import { regionen } from '../data/einsatzgebiet';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /* TODO Kunde: Open-Graph-Bild (1200×630) bereitstellen und hier eintragen. */
  ogImage?: string;
}

const { title, description, ogImage = '/og-bild.jpg' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;

/*
  LocalBusiness-JSON-LD.

  Noch fehlende Angaben werden weggelassen statt mit Platzhaltern gefüllt:
  ein `telephone: "[TODO …]"` wäre für Google eine falsche Tatsachenangabe.
  Sobald site.telHref gesetzt ist, erscheint das Feld automatisch.

  Bewusst NICHT enthalten: aggregateRating, review, foundingDate,
  numberOfEmployees, award. Dafür gibt es keine Grundlage.
*/
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.firmierung,
  /* Nur wenn die Firmierung vom Markennamen abweicht — sonst redundant. */
  ...(site.firmierung !== site.name ? { alternateName: site.name } : {}),
  description,
  url: canonical,
  ...(site.telHref ? { telephone: site.telHref } : {}),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.strasse,
    postalCode: site.plz,
    addressLocality: site.ort,
    addressCountry: 'DE',
  },
  /* Stuttgart steht zuerst — die Reihenfolge signalisiert den Schwerpunkt. */
  areaServed: regionen.map((region) => ({ '@type': region.typ, name: region.name })),

  /*
    Erreichbarkeit maschinenlesbar. Vorher weggelassen, weil die Wochentage
    fehlten — eine Angabe ohne dayOfWeek wäre nicht unvollständig, sondern
    falsch gewesen.
  */
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: site.oeffnungszeiten.tage,
      opens: site.oeffnungszeiten.von,
      closes: site.oeffnungszeiten.bis,
    },
  ],
  image: ogUrl,
  logo: new URL('/logo.png', Astro.site).href,
  knowsLanguage: 'de-DE',
  makesOffer: [
    'Unterhaltsreinigung',
    'Glas- und Rahmenreinigung',
    'Grund- und Sonderreinigung',
    'Bauendreinigung',
    'Außenanlagen und Winterdienst',
    'Hausmeisterservice',
  ].map((name) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name, serviceType: 'Gebäudereinigung' },
  })),
};
---

<!doctype html>
<!--
  `kein-js` wird vom Kopfmenü-Skript entfernt. Bleibt die Klasse stehen,
  greifen die CSS-Rückfälle in global.css.
-->
<html lang="de" class="kein-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Kein Analytics, kein Tracking, keine externen Skripte. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-btn focus:bg-ink focus:px-4 focus:py-2 focus:text-small focus:text-surface"
      >Zum Inhalt springen</a
    >
    <slot />
  </body>
</html>
