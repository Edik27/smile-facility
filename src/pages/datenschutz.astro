---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { routes, site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

/*
  ────────────────────────────────────────────────────────────────────────────
  WICHTIG: Das hier ist KEINE Datenschutzerklärung.

  Eine Datenschutzerklärung nach Art. 13 DSGVO ist ein Rechtsdokument. Sie
  muss Rechtsgrundlagen, Speicherfristen, Empfänger, Auftragsverarbeiter und
  Betroffenenrechte verbindlich benennen — und sie muss von jemandem kommen,
  der dafür haftet. Ich schreibe sie nicht.

  Was diese Seite stattdessen enthält: die technischen Tatsachen über diese
  Website, nachgemessen im Browser. Genau diese Angaben fragt jeder
  Generator und jeder Anwalt ab, und niemand kann sie später rekonstruieren.
  Sie sind die Vorarbeit, nicht das Ergebnis.

  Nachgemessen am 17.09.2026 auf allen Seiten:
  - document.cookie leer, localStorage und sessionStorage leer
  - 8 Ressourcen geladen, davon 0 von fremden Servern
  - kein Service Worker
  - keine externe URL im gesamten Build außer schema.org im JSON-LD
    (reine Namensraum-Angabe, kein Abruf)
  ────────────────────────────────────────────────────────────────────────────
*/
const title = 'Datenschutz | S.mile Facility Services';
const description =
  'Technische Angaben zur Datenverarbeitung auf dieser Website: keine Cookies, kein Tracking, keine externen Dienste, selbst gehostete Schriften.';

const tatsachen = [
  {
    frage: 'Cookies',
    antwort:
      'Diese Website setzt keine Cookies. Nachgemessen auf allen Seiten: document.cookie ist leer, localStorage und sessionStorage sind leer. Es gibt deshalb auch kein Einwilligungsbanner — es gäbe nichts einzuwilligen.',
  },
  {
    frage: 'Analyse und Tracking',
    antwort:
      'Kein Analysewerkzeug, keine Zählpixel, keine Conversion-Tracker, keine Einbindung sozialer Netzwerke. Weder Google Analytics noch eine datenschutzfreundliche Alternative.',
  },
  {
    frage: 'Externe Dienste',
    antwort:
      'Keine. Beim Aufruf einer Seite werden ausschließlich Dateien vom eigenen Server geladen — im Test 8 Ressourcen, davon 0 von fremden Servern. Es gibt keine eingebetteten Karten, Videos oder Schriftdienste.',
  },
  {
    frage: 'Schriften',
    antwort:
      'Poppins und Inter werden selbst gehostet und mit der Seite ausgeliefert. Es findet keine Verbindung zu Google Fonts statt — die IP-Adresse der Besucher wird dadurch nicht an Dritte übermittelt.',
  },
  {
    frage: 'JavaScript',
    antwort:
      'Die Seite lädt kein JavaScript von fremden Servern. Ein kleines eigenes Skript steuert die Aufklappmenüs in der Kopfzeile und die Vorauswahl im Anfrageformular. Es sendet keine Daten und speichert nichts.',
  },
  {
    frage: 'Anfrageformular',
    antwort:
      'Das Formular auf der Anfrageseite überträgt derzeit keine Daten an diese Website. Es öffnet das Mailprogramm des Absenders mit den eingegebenen Angaben; der Versand erfolgt über den eigenen E-Mail-Anbieter. [TODO Kunde: Sobald ein Formulardienst eingerichtet ist, muss er hier benannt werden — mit Anbieter, Serverstandort und Auftragsverarbeitungsvertrag.]',
  },
  {
    frage: 'Hosting und Server-Protokolle',
    antwort:
      `Die Website wird bei ${site.hosting} betrieben, der Server steht in ${site.hostingStandort}. Jeder Webserver protokolliert technisch bedingt IP-Adresse, Zeitpunkt, abgerufene Datei und Browserkennung. [TODO Kunde: Für die Erklärung fehlen noch drei Angaben — die genaue juristische Person mit Anschrift, die Speicherdauer der Protokolle und ein Auftragsverarbeitungsvertrag nach Art. 28 DSGVO. Der AV-Vertrag ist Pflicht und wird bei Hostinger im Kundenkonto abgeschlossen.]`,
  },
  {
    frage: 'Serverstandort',
    antwort:
      `Der Server steht in ${site.hostingStandort}, also innerhalb der Europäischen Union. Eine Übermittlung in ein Drittland nach Art. 44 ff. DSGVO findet für das Hosting damit nicht statt; Standardvertragsklauseln sind dafür nicht erforderlich. Sollte der Standort später gewechselt werden, muss diese Angabe geprüft werden.`,
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <main id="inhalt">
    <Breadcrumb stufen={[{ label: 'Start', href: '/' }, { label: 'Datenschutz' }]} />

    <div class="wrap pb-12 pt-8 md:pt-10">
      <h1 class="text-h1 font-heading font-bold text-ink">Datenschutz</h1>

      <div class="mt-8 max-w-[62ch] rounded-img border border-line p-6">
        <h2 class="text-h3 font-heading font-semibold text-ink">
          Diese Seite ist noch nicht die Datenschutzerklärung
        </h2>
        <p class="mt-3 text-body text-ink">
          [TODO Kunde: Die rechtlich verbindliche Datenschutzerklärung nach Art. 13 DSGVO fehlt
          noch. Sie muss Rechtsgrundlagen, Speicherfristen, Empfänger und Betroffenenrechte
          benennen und gehört in die Hand eines Anwalts oder eines geprüften Generators.]
        </p>
        <p class="mt-3 text-body text-grey">
          Was unten steht, sind die technischen Tatsachen über diese Website — nachgemessen,
          nicht behauptet. Sie sind die Vorlage für die Erklärung: genau diese Angaben fragt
          jeder Generator ab, und später lassen sie sich kaum noch rekonstruieren.
        </p>
      </div>
    </div>

    <section class="sektion border-t border-line">
      <div class="wrap">
        <h2 class="text-h2 font-heading font-semibold text-ink">
          Was diese Website technisch tut — und was nicht
        </h2>

        <dl class="mt-12 border-t border-line">
          {
            tatsachen.map((t) => (
              <div class="grid gap-x-12 gap-y-2 border-b border-line py-8 lg:grid-cols-12">
                <dt class="text-h3 font-heading font-semibold text-ink lg:col-span-4">
                  {t.frage}
                </dt>
                <dd class="max-w-[62ch] text-body text-grey lg:col-span-7 lg:col-start-6">
                  {t.antwort}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-14 max-w-[62ch]">
          <h2 class="text-h3 font-heading font-semibold text-ink">Verantwortlich</h2>
          <address class="mt-3 flex flex-col gap-1 text-body not-italic text-ink">
            <span>{site.firmierung}</span>
            <span>{site.ansprechperson}</span>
            <span>{site.strasse}</span>
            <span>{site.plz} {site.ort}</span>
            <span class="mt-2">
              <a href={`mailto:${site.email}`} class="textlink">{site.email}</a>
            </span>
          </address>
          <p class="mt-4 text-body text-grey">
            Vollständige Anbieterangaben im{' '}
            <a href={routes.impressum} class="textlink">Impressum</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
