---
import CtaAbschluss from '../../components/CtaAbschluss.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { objekttypSeiten } from '../../data/objekttypen';
import { objekttypHref, routes, site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

/*
  Verteiler für die Objektarten, bewusst kurz — wie der Leistungs-Hub.
  Keine Inhalte, die auf den Unterseiten stehen.

  Kein Kachelblock: der steht auf der Startseite mit Fotos. Hier eine
  Zeilenliste, damit Hub und Startseite sich nicht doppeln.
*/
const title = 'Objektarten, die wir betreuen | S.mile';
const description =
  'Büro, Handel, Industrie, Praxen, Hotellerie und Immobilienverwaltungen. Was sich je Objektart bei Zeitfenster, Zutritt und Prüfpunkten unterscheidet.';
---

<BaseLayout title={title} description={description}>
  <Header />

  <main id="inhalt">
    <Breadcrumb stufen={[{ label: 'Start', href: '/' }, { label: 'Objekttypen' }]} />

    <div class="wrap pb-4 pt-8 md:pt-10">
      <h1 class="text-h1 font-heading font-bold text-ink">
        Jede Objektart hat ihre eigenen Regeln
      </h1>
      <p class="mt-6 max-w-[58ch] text-lead text-grey">
        Die Leistungen sind überall dieselben sechs. Was sich unterscheidet, sind Zeitfenster,
        Zutrittsregeln und die Punkte, auf die bei der Kontrolle geschaut wird.
      </p>
      <p class="mt-4 max-w-[58ch] text-body text-grey">
        Im Einsatz in {site.einsatzgebiet}. Begehung und Leistungsverzeichnis sind kostenlos.
      </p>
    </div>

    <section class="sektion">
      <div class="wrap">
        <ul class="border-t border-line">
          {
            objekttypSeiten.map((o) => (
              <li class="border-b border-line">
                <a
                  href={objekttypHref(o.slug)}
                  class="group grid gap-2 py-7 lg:grid-cols-12 lg:gap-8 lg:py-8"
                >
                  <h2 class="text-h3 font-heading font-semibold text-ink transition-[color] duration-150 group-hover:text-primary-deep lg:col-span-5">
                    {o.titel}
                  </h2>
                  <p class="max-w-[62ch] text-body text-grey lg:col-span-7">{o.beschreibung}</p>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="mt-10">
          <a href={routes.leistungen} class="textlink text-body">
            Die sechs Leistungen im Überblick
          </a>
        </p>
      </div>
    </section>

    <CtaAbschluss />
  </main>

  <Footer />
</BaseLayout>
