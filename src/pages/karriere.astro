---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { gebietKurz } from '../data/einsatzgebiet';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

/*
  Zweitwichtigstes Ziel der Website: Bewerbungen. Personal ist in dieser
  Branche der eigentliche Engpass.

  Bewusst NICHT geschrieben: Löhne, Zuschläge, Urlaubstage, Tarifbindung,
  „familiäres Team“, „attraktive Vergütung“. Nichts davon ist belegt, und
  Bewerber in dieser Branche erkennen Floskeln so schnell wie Property
  Manager.

  Ebenfalls nicht: Bewerbungsformular. Ohne Formularziel wäre es eine
  Attrappe — E-Mail und Telefon sind hier ohnehin der übliche Weg.

  Personen sind „Reinigungskräfte“, nicht „Gebäudereiniger“ — die
  Berufsbezeichnung ist geschützt.
*/
const title = 'Stellenangebote | S.mile Facility Services';
const description =
  'Reinigungskräfte und Objektleitung für Gewerbeobjekte in Stuttgart. Bewerbung per E-Mail oder telefonisch, Rückmeldung innerhalb eines Werktags.';

const stellen = [
  {
    titel: 'Reinigungskraft für Gewerbeobjekte',
    aufgaben: [
      'Unterhaltsreinigung in Büro-, Handels- oder Praxisflächen nach festem Leistungsverzeichnis',
      'Arbeit in einem festen Objekt, nicht wechselnd von Tag zu Tag',
      'Meldung von Auffälligkeiten an die Objektleitung',
    ],
    voraussetzungen: [
      'Zuverlässigkeit bei festen Zeitfenstern — das ist die Anforderung, an der in dieser Branche alles hängt',
      'Deutsch so weit, dass Absprachen im Objekt funktionieren',
      '[TODO Kunde: Ist ein Führerschein oder ein eigenes Fahrzeug erforderlich?]',
    ],
  },
  {
    titel: 'Objektleitung',
    aufgaben: [
      'Einarbeitung und Einweisung der Reinigungskräfte im Objekt',
      'Kontrollgänge und Dokumentation von Abweichungen',
      'Erste Ansprechperson vor Ort für den Auftraggeber',
    ],
    voraussetzungen: [
      'Erfahrung in der Gebäudereinigung oder in einer vergleichbaren Tätigkeit',
      'Bereitschaft, mehrere Objekte zu betreuen',
      '[TODO Kunde: Führerschein Klasse B vorausgesetzt? Wird ein Fahrzeug gestellt?]',
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <main id="inhalt">
    <Breadcrumb stufen={[{ label: 'Start', href: '/' }, { label: 'Karriere' }]} />

    <div class="wrap pb-12 pt-8 md:pt-10">
      <h1 class="text-h1 font-heading font-bold text-ink">
        Reinigungskräfte und Objektleitung gesucht
      </h1>
      <p class="mt-6 max-w-[58ch] text-lead text-grey">
        Wir besetzen laufend Stellen in {gebietKurz}. Wer bei uns anfängt, arbeitet in einem
        festen Objekt mit einem schriftlichen Leistungsverzeichnis — nicht nach Zuruf und
        nicht jeden Tag woanders.
      </p>
      <p class="mt-6 max-w-[62ch] rounded-img border border-line p-5 text-body text-ink">
        [TODO Kunde: Anstellungsart, Arbeitszeiten und Vergütung fehlen. Für Bewerbungen sind
        das die drei Angaben, nach denen zuerst geschaut wird — ohne sie bleibt diese Seite
        deutlich unter ihren Möglichkeiten.]
      </p>
    </div>

    <section class="sektion border-t border-line">
      <div class="wrap">
        <h2 class="text-h2 font-heading font-semibold text-ink">Offene Stellen</h2>

        <div class="mt-12 border-t border-line">
          {
            stellen.map((stelle) => (
              <div class="border-b border-line py-9 md:py-11">
                <h3 class="text-h3 font-heading font-semibold text-ink">{stelle.titel}</h3>
                <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:gap-12">
                  <div class="lg:col-span-6">
                    <h4 class="text-small font-heading font-semibold text-ink">Aufgaben</h4>
                    <ul class="mt-3 flex flex-col gap-3">
                      {stelle.aufgaben.map((punkt) => (
                        <li class="flex gap-3 text-body text-grey">
                          <span
                            class="mt-[0.6em] size-2 shrink-0 rounded-full bg-primary"
                            aria-hidden="true"
                          />
                          <span class="max-w-[62ch]">{punkt}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="lg:col-span-6">
                    <h4 class="text-small font-heading font-semibold text-ink">Voraussetzungen</h4>
                    <ul class="mt-3 flex flex-col gap-3">
                      {stelle.voraussetzungen.map((punkt) => (
                        <li class="flex gap-3 text-body text-grey">
                          <span
                            class="mt-[0.6em] size-2 shrink-0 rounded-full bg-primary"
                            aria-hidden="true"
                          />
                          <span class="max-w-[62ch]">{punkt}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sektion border-t border-line">
      <div class="wrap grid gap-6 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-h2 font-heading font-semibold text-ink">So bewerben Sie sich</h2>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <div class="flex max-w-[62ch] flex-col gap-4 text-body text-ink">
            <p>
              Eine E-Mail mit Name, Telefonnummer und dem Ort, in dem Sie arbeiten möchten,
              genügt für den ersten Kontakt. Ein vollständiger Lebenslauf kann später
              nachkommen.
            </p>
            <p>
              Sie erhalten eine Rückmeldung innerhalb eines Werktags — dieselbe Zusage, die
              für Anfragen von Auftraggebern gilt.
            </p>
          </div>

          <dl class="mt-8 flex flex-col gap-4">
            <div>
              <dt class="text-small text-grey">E-Mail</dt>
              <dd class="text-body">
                <a href={`mailto:${site.email}`} class="textlink">{site.email}</a>
              </dd>
            </div>
            <div>
              <dt class="text-small text-grey">Telefon</dt>
              <dd class="text-body font-heading font-semibold text-ink">{site.telefon}</dd>
            </div>
            <div>
              <dt class="text-small text-grey">Ansprechperson</dt>
              <dd class="text-body text-ink">{site.ansprechperson}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
