---
import { hauptnavigation } from '../data/navigation';
import { routes } from '../data/site';
import Button from './ui/Button.astro';
import LogoLockup from './ui/LogoLockup.astro';

/*
  Sticky ab dem ersten Scrollpixel, abgesetzt durch eine 1px-Trennlinie
  statt eines Schattens. Das mobile Menü läuft über <details>/<summary> —
  korrekte Semantik und Tastaturbedienung ohne eine Zeile JavaScript.
*/
---

<header class="sticky top-0 z-50 border-b border-line bg-surface">
  <div class="wrap flex h-16 items-center gap-3 md:h-20 md:gap-6">
    <a href="/" class="mr-auto rounded-btn" aria-label="S.mile Facility Services, zur Startseite">
      <LogoLockup />
    </a>

    <nav aria-label="Hauptnavigation" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          hauptnavigation.map((eintrag) => (
            <li>
              <a
                href={eintrag.href}
                class="text-small text-ink transition-[color] duration-150 hover:text-primary-deep"
              >
                {eintrag.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={routes.anfrage} class="max-md:px-3.5 max-md:py-2.5">Angebot anfordern</Button>

    <details class="burger lg:hidden">
      <summary
        class="flex size-10 items-center justify-center rounded-btn border border-line text-ink"
        aria-label="Menü"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
          class="burger-auf"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
          class="burger-zu"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>

      <nav
        aria-label="Hauptnavigation, mobil"
        class="absolute left-0 right-0 top-full border-b border-line bg-surface"
      >
        <ul class="wrap flex flex-col py-2">
          {
            hauptnavigation.map((eintrag) => (
              <li class="border-b border-line last:border-b-0">
                <a href={eintrag.href} class="block py-3.5 text-lead text-ink">
                  {eintrag.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
