---
import { andereObjekttypen } from '../../data/objekttypen';

/*
  Die übrigen Objektarten als Linkliste. Schmales Band mit Haarlinien —
  dasselbe ruhige Muster wie „Weitere Leistungen“ und der Karriere-Teaser.
*/
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const andere = andereObjekttypen(slug);
---

<section class="border-y border-line">
  <div class="wrap py-12 md:py-14">
    <h2 class="text-h3 font-heading font-semibold text-ink">Weitere Objektarten</h2>
    <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
      {
        andere.map((o) => (
          <li>
            <a href={o.href} class="textlink-hover text-body">
              {o.titel}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
