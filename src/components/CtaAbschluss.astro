---
import { routes, site } from '../data/site';
import Button from './ui/Button.astro';

/*
  Der einzige vollflächige --primary-Block der Seite. Asymmetrisch statt
  zentriert. Weiße Schrift ab 24px (text-cta beginnt bei 1,5rem) — bei
  4,29:1 ist das für große Schrift zulässig, für kleinere Labels nicht,
  deshalb steht der Button in Weiß mit --primary-deep als Textfarbe.
  Die Klasse „on-primary“ schaltet den Fokusring auf --base, weil
  --primary-deep auf --primary unsichtbar wäre.

  Die Leistungsseiten nutzen denselben Block mit eigener Überschrift und
  eigenem Ziel-Href (?leistung=<slug>), damit die Anfrageseite die Leistung
  vorauswählen kann. Deshalb Props statt einer zweiten Komponente — es soll
  genau eine pinke Fläche geben, und die soll überall gleich aussehen.
*/
interface Props {
  titel?: string;
  href?: string;
}

const {
  titel = 'Angebot für Ihr Objekt — Begehung und Leistungsverzeichnis kostenlos.',
  href = routes.anfrage,
}: Props = Astro.props;
---

<section class="on-primary bg-primary">
  <div class="wrap grid gap-10 py-16 md:py-24 lg:grid-cols-12 lg:items-end lg:gap-12">
    <h2 class="text-cta font-heading font-bold text-surface lg:col-span-7">{titel}</h2>

    <div class="lg:col-span-5 lg:col-start-8">
      <Button href={href} variant="onPrimary" class="w-full sm:w-auto">
        Angebot anfordern
      </Button>

      <p class="mt-6 text-lead text-surface">
        Oder rufen Sie an:{' '}
        {
          site.telHref ? (
            <a
              href={`tel:${site.telHref}`}
              class="font-heading font-semibold text-surface underline decoration-1 underline-offset-4 hover:decoration-2"
            >
              {site.telefon}
            </a>
          ) : (
            <span class="font-heading font-semibold text-surface">{site.telefon}</span>
          )
        }
        <br />
        <span class="text-small">{site.bueroZeiten}</span>
      </p>
    </div>
  </div>
</section>
