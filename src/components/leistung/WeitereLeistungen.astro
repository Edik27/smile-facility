---
import { andereLeistungen } from '../../data/leistungen';

/*
  Die übrigen fünf Leistungen als Linkliste, nicht als zweiter Kachelblock.
  Der Kachelblock steht auf der Startseite und im Hub; ihn hier ein drittes
  Mal zu zeigen, macht das Seitenende lang, ohne etwas zu beantworten.

  Schmales Band mit Haarlinien oben und unten — dasselbe ruhige Muster wie
  der Karriere-Teaser auf der Startseite.
*/
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const andere = andereLeistungen(slug);
---

<section class="border-y border-line">
  <div class="wrap py-12 md:py-14">
    <h2 class="text-h3 font-heading font-semibold text-ink">Weitere Leistungen</h2>
    <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
      {
        andere.map((leistung) => (
          <li>
            <a href={leistung.href} class="textlink-hover text-body">
              {leistung.titel}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
