---
import type { FaqEintrag } from '../../data/leistungen';
import Ausklapper from '../ui/Ausklapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/*
  Fragen und Antworten zum Aufklappen, über <details>/<summary> und damit
  ohne JavaScript. Die Mechanik steckt in ui/Ausklapper.astro, hier bleibt
  nur die Liste.

  Bewusst ohne FAQPage-Markup: das liefert seit 2023 für gewerbliche Seiten
  keine Rich Results mehr. Inhalt in geschlossenen <details> wird von Google
  normal indexiert — es gibt keinen SEO-Grund, die Antworten offen zu lassen.

  <ul> um die Einträge, damit Screenreader die Anzahl der Fragen ankündigen.
  Getrennt durch 1px --line, kein Kartencontainer, kein Schatten — gleiches
  Prinzip wie die Objekttypen-Zeilen.
*/
interface Props {
  eintraege: FaqEintrag[];
}

const { eintraege } = Astro.props;
---

<section class="sektion border-t border-line">
  <div class="wrap">
    <SectionHeading titel="Fragen, die uns dazu erreichen" />

    <ul class="mt-10 border-t border-line">
      {
        eintraege.map((eintrag) => (
          <li class="border-b border-line">
            <Ausklapper frage={eintrag.frage}>{eintrag.antwort}</Ausklapper>
          </li>
        ))
      }
    </ul>
  </div>
</section>
