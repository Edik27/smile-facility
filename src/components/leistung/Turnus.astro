---
import SectionHeading from '../ui/SectionHeading.astro';

/*
  Turnus und Zeitfenster. Bewusst ohne Trennlinien und ohne Spaltenraster:
  die Stufen stehen als gestapelte Blöcke im Textmaß. Sonst wäre es das
  dritte Mal auf derselben Seite dasselbe Zeilenmuster wie bei „Was
  enthalten ist“ und der FAQ.

  Keine Preise. Der Turnus bestimmt den Preis, aber die Zahl gehört ins
  Angebot nach der Begehung, nicht auf die Seite.
*/
interface Props {
  titel?: string;
  lead: string;
  stufen: { intervall: string; text: string }[];
  zeitfenster: string[];
}

const { titel = 'Turnus und Zeitfenster', lead, stufen, zeitfenster } = Astro.props;
---

<section class="sektion border-t border-line">
  <div class="wrap">
    <SectionHeading titel={titel} lead={lead} />

    <div class="mt-10 flex max-w-[68ch] flex-col gap-8">
      {
        stufen.map((stufe) => (
          <div>
            <h3 class="text-h3 font-heading font-semibold text-ink">{stufe.intervall}</h3>
            <p class="mt-2 max-w-[62ch] text-body text-grey">{stufe.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex max-w-[62ch] flex-col gap-4">
      {zeitfenster.map((absatz) => <p class="text-body text-ink">{absatz}</p>)}
    </div>
  </div>
</section>
