---
import { testAngebote, zusagen } from '../data/arbeitsweise';
import SectionHeading from './ui/SectionHeading.astro';

/*
  Der tragende Block der Startseite und der Platz, an dem sonst eine
  Referenzliste stünde. Deshalb: keine Kachelreihe, sondern eine
  Definitionsliste mit viel Luft und 1px-Trennern.

  Die Struktur ist so gebaut, dass ein Referenzblock später zwischen dieser
  Sektion und dem Karriere-Teaser eingehängt werden kann, ohne dass hier
  etwas umgebaut werden muss.
*/
---

<section id="arbeitsweise" class="sektion bg-surface-alt">
  <div class="wrap">
    <SectionHeading
      titel="Wie wir arbeiten"
      lead="Fünf Zusagen, die Sie uns gegenüber einfordern können. Wir halten sie im Leistungsverzeichnis Ihres Objekts schriftlich fest."
    />

    <dl class="mt-12 border-t border-line">
      {
        zusagen.map((zusage) => (
          <div class="grid gap-x-8 gap-y-2 border-b border-line py-8 lg:grid-cols-12 lg:py-10">
            <dt class="flex gap-3 lg:col-span-5">
              <span
                class="mt-[0.55em] size-2 shrink-0 rounded-full bg-primary"
                aria-hidden="true"
              />
              <span class="text-h3 font-heading font-semibold text-ink">{zusage.titel}</span>
            </dt>
            <dd class="max-w-[62ch] text-body text-grey lg:col-span-6 lg:col-start-7">
              {zusage.erlaeuterung}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-14 rounded-img border border-line bg-surface p-7 md:p-10">
      <h3 class="max-w-[38ch] text-h3 font-heading font-semibold text-ink">
        So können Sie uns testen, bevor Sie sich binden
      </h3>
      <ul class="mt-6 grid gap-5 lg:grid-cols-2 lg:gap-x-12 lg:gap-y-6">
        {
          testAngebote.map((angebot) => (
            <li class="flex gap-3 text-body text-ink">
              <span
                class="mt-[0.6em] size-2 shrink-0 rounded-full bg-primary"
                aria-hidden="true"
              />
              <span class="max-w-[46ch]">{angebot}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
