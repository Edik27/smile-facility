---
import { routes, site } from '../data/site';

/*
  Ruhiger, schmaler Block auf Weiß mit Haarlinien oben und unten.
  Bewusst kein pinker Block: er würde mit dem Abschluss-CTA konkurrieren.

  Rechtlicher Hinweis, der hier hineinspielt: „Gebäudereiniger“ ist eine
  geschützte Berufsbezeichnung. Die Texte sprechen deshalb durchgehend von
  Reinigungskräften und Objektleitung.
*/
---

<section class="border-y border-line">
  <div class="wrap flex flex-col gap-5 py-12 md:flex-row md:items-end md:justify-between md:gap-12 md:py-14">
    <div>
      <h2 class="text-h3 font-heading font-semibold text-ink">
        Reinigungskräfte und Objektleitung gesucht
      </h2>
      <p class="mt-3 max-w-[62ch] text-body text-grey">
        Wir besetzen laufend Stellen in der Unterhaltsreinigung und in der Objektleitung in {
          site.einsatzgebiet
        }.
        <!-- TODO Kunde: Anstellungsarten ergänzen (Vollzeit, Teilzeit, Minijob?) und ob Führerschein nötig ist. -->
      </p>
    </div>
    <p class="shrink-0">
      <a href={routes.karriere} class="textlink text-body">Offene Stellen ansehen</a>
    </p>
  </div>
</section>
